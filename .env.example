# Gemini AI API Key for Chatbot
GEMINI_API_KEY=your_gemini_api_key_here

# Production Site URL (used for canonical URLs, sitemap, robots, and openGraph metadata)
NEXT_PUBLIC_SITE_URL=https://shivi.in

# Google Search Console Verification Token (optional - insert your GSC meta verification string)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_token_here
